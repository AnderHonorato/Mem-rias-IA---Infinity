{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://memorias-ia-infinity.local/schemas/memory.schema.json",
  "title": "Canonical Memory",
  "type": "object",
  "required": ["id", "schema_version", "type", "status", "scope", "created_at", "confidence", "sensitivity", "source", "generated_by"],
  "properties": {
    "id": {"type": "string", "pattern": "^(KNOW|PREF)-[0-9]{4}-[0-9]{6}$"},
    "schema_version": {"const": 1},
    "type": {"enum": ["semantic-memory", "preference", "episodic-memory", "procedural-memory", "temporal-memory"]},
    "status": {"enum": ["active", "superseded", "disputed", "review", "archived", "draft"]},
    "scope": {"type": "string", "minLength": 1},
    "created_at": {"type": ["string", "object"]},
    "confidence": {"enum": ["confirmed", "observed", "sourced", "inferred", "uncertain", "disputed"]},
    "sensitivity": {"enum": ["normal", "personal", "restricted"]},
    "source": {"type": "object"},
    "generated_by": {"type": "object"},
    "valid_from": {}, "valid_until": {}, "review_after": {},
    "supersedes": {"type": "string"}, "superseded_by": {"type": "string"}
  },
  "additionalProperties": true
}
