{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://memorias-ia-infinity.local/schemas/reflection.schema.json",
  "title": "Decision Trace / Reflection",
  "type": "object",
  "required": ["id", "schema_version", "type", "status", "scope", "created_at", "confidence", "reasoning_visibility", "sensitivity", "source", "generated_by"],
  "properties": {
    "id": {"type": "string", "pattern": "^TRACE-[0-9]{4}-[0-9]{6}$"},
    "schema_version": {"const": 1},
    "type": {"enum": ["decision-trace", "reflection"]},
    "status": {"enum": ["completed", "active", "archived", "draft"]},
    "scope": {"type": "string", "minLength": 1},
    "created_at": {},
    "confidence": {"enum": ["low", "medium", "high", "confirmed", "observed", "sourced", "inferred", "uncertain", "disputed"]},
    "reasoning_visibility": {"enum": ["exposed", "summarized", "unavailable"]},
    "sensitivity": {"enum": ["normal", "personal", "restricted"]},
    "source": {"type": "object"},
    "generated_by": {"type": "object"}
  },
  "additionalProperties": true
}
